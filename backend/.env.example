# Backend Environment Variables Example
# Copy to .env and fill in real values. Never commit .env.

# Port the API listens on.
PORT=5000

# MongoDB connection string. Atlas SRV strings are validated with
# mongodb-connection-string-url, which enforces a replica set for SRV hosts.
MONGO_URI=mongodb://localhost:27017/employee-payroll

# At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=1d

# Comma separated allowlist of trusted frontend origins. Values are matched
# exactly (no trailing slash). Requests without an Origin header, and any
# localhost/127.0.0.1 origin while NODE_ENV is not production, are allowed
# through so curl, health checks and local development keep working.
CLIENT_URL=http://localhost:5173

NODE_ENV=development

# Optional. Clock hour (0-23, IST) after which a check-in is recorded as Late.
# Defaults to 9.
LATE_AFTER_IST_HOUR=9

# Optional. Comma separated DNS resolvers, applied before the MongoDB connection.
# Leave unset when the network resolves DNS normally.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Optional. Allows the permanent delete employee endpoint. Keep this unset
# outside a deliberate data-cleanup session.
# ALLOW_HARD_DELETE=true

# ------------------------------------------------------------------
# Development / test / tooling only
# ------------------------------------------------------------------

# Optional. Database used by `npm run test:integration`. Defaults to
# mongodb://127.0.0.1:27017/eap_integration_test. That database is wiped
# between test files, so never point it at a database with real data.
# MONGO_TEST_URI=mongodb://127.0.0.1:27017/eap_integration_test

# Optional. Demo credentials used by `npm run seed` for a local seed database.
# SEED_ADMIN_PASSWORD=
# SEED_HR_PASSWORD=
# SEED_EMPLOYEE_PASSWORD=

# Required by `npm run smoke`, which runs against an already running server.
# SMOKE_EMAIL=admin@test.com
# SMOKE_PASSWORD=
# SMOKE_API_URL=http://127.0.0.1:5000