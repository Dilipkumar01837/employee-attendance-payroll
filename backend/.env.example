PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/employee_attendance_payroll

JWT_SECRET=replace-with-a-strong-secret

# Comma separated list of allowed browser origins.
# Outside production any localhost port is also accepted, so Vite moving off
# 5173 when the port is busy does not break the API.
CLIENT_URL=http://localhost:5173

# CLIENT_URLS=http://localhost:5173,https://hr.example.com

NODE_ENV=development
