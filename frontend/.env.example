# Frontend Environment Variables Example
#
# The backend URL. Leave it unset locally to use the Vite dev-server proxy in
# vite.config.js (recommended). Set it in the Vercel project environment for
# production; it must be the public https URL of the *backend* project, with no
# trailing slash and no /api suffix.
#
# VITE_API_URL=https://your-backend-project.vercel.app
VITE_API_URL=http://localhost:5000
